// Cloudflare WARP Controller & System Logs component
/*
 * ============================================================================
 * Developer Warning: Refer to architecture.md Section 6 for full Slint-Rust 
 * synchronization rules before modifying this file!
 * ============================================================================
 */

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component WarpControlPanel inherits Rectangle {
    in-out property <string> warp_status_text;
    in-out property <string> warp_status_color;
    in-out property <string> warp_network_text;
    in-out property <string> warp_mode_badge;
    in-out property <bool> warp_toggle_state;
    in-out property <bool> warp_mode_doh_active;
    in-out property <[string]> console_logs;

    callback warp_toggle_clicked(bool);
    callback warp_mode_clicked(string);
    callback install_rpm_clicked();

    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 24px;
    
    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        alignment: space-between;
        
        // Upper Section: Shield emblem and connection toggle
        VerticalLayout {
            spacing: 16px;
            alignment: start;
            
            // Shield Graphics Center
            Rectangle {
                height: 160px;
                background: transparent;
                
                // Static status halo
                Rectangle {
                    width: 110px;
                    height: 110px;
                    border-radius: 55px;
                    background: transparent;
                    border-width: 1.5px;
                    border-color: root.warp_status_text == "Connected" ? Theme.success.transparentize(90%) : (root.warp_status_text == "Connecting..." ? Theme.warning.transparentize(90%) : Theme.danger.transparentize(90%));
                }

                // Glowing Shield Circle
                shield-container := Rectangle {
                    width: 84px;
                    height: 84px;
                    border-radius: 42px;
                    background: Theme.interior-bg;
                    border-width: 1px;
                    border-color: root.warp_status_text == "Connected" ? Theme.success : (root.warp_status_text == "Connecting..." ? Theme.warning : Theme.danger);
                    
                    Image {
                        source: @image-url("../../assets/shield.svg");
                        width: 38px;
                        height: 38px;
                        colorize: root.warp_status_text == "Connected" ? Theme.success : (root.warp_status_text == "Connecting..." ? Theme.warning : Theme.danger);
                        x: (shield-container.width - self.width) / 2;
                        y: (shield-container.height - self.height) / 2;
                    }

                    // Led dynamic dot inside shield corner
                    Rectangle {
                        x: 58px;
                        y: 6px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: root.warp_status_text == "Connected" ? Theme.success : (root.warp_status_text == "Connecting..." ? Theme.warning : Theme.danger);
                        border-width: 2px;
                        border-color: Theme.interior-bg;
                    }
                }
            }

            // Status Info Block
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Cloudflare WARP Tunnel";
                    font-size: 15px;
                    font-weight: 800;
                    color: #f8fafc;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.warp_status_text;
                    font-size: 13px;
                    font-weight: 900;
                    color: root.warp_status_text == "Connected" ? Theme.success : (root.warp_status_text == "Connecting..." ? Theme.warning : Theme.danger);
                    font-family: "JetBrains Mono";
                    horizontal-alignment: center;
                    letter-spacing: 1.5px;
                }
                Text {
                    text: root.warp_network_text;
                    font-size: 12px;
                    color: #64748b;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    width: 280px;
                }
                
                // Operating mode active status badge
                if (root.warp_status_text == "Connected") : HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        background: Theme.card-bg.transparentize(15%);
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 12px;
                        height: 22px;
                        
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: root.warp_mode_badge;
                                font-size: 12px;
                                font-weight: 800;
                                color: #cbd5e1;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
                      // iOS styled Toggle connected switch
            Rectangle {
                height: 48px;
                background: Theme.interior-bg.transparentize(30%);
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 14px;
                
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;
                    Text {
                        text: root.warp_toggle_state ? "CONNECT CLIENT ACTIVATED" : "CONNECT CLIENT DEACTIVATED";
                        font-size: 12px;
                        font-weight: 800;
                        color: root.warp_toggle_state ? Theme.success : Theme.text-muted;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                    }
 
                    // Interactive switch toggle pill
                    Rectangle {
                        width: 44px;
                        height: 24px;
                        border-radius: 12px;
                        background: root.warp_toggle_state ? (root.warp_mode_doh_active ? Theme.accent : Theme.warning) : Theme.base-bg;
                        y: 11px;
                        
                        // Inner toggle circular knob
                        Rectangle {
                            x: root.warp_toggle_state ? 22px : 2px;
                            y: 2px;
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: #ffffff;
                            
                            animate x { duration: 200ms; easing: ease-in-out; }
                        }

                        TouchArea {
                            clicked => {
                                root.warp_toggle_state = !root.warp_toggle_state;
                                root.warp_toggle_clicked(root.warp_toggle_state);
                            }
                        }
                    }
                }
            }

            // WARP mode selection tabs
            VerticalLayout {
                spacing: 8px;
                padding-top: 8px;
                
                Text {
                    text: "OPERATION TUNNEL MODE";
                    font-size: 12px;
                    font-weight: 800;
                    color: #475569;
                    letter-spacing: 1.2px;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    // Tab 1: DNS Only
                    Rectangle {
                        width: 140px;
                        height: 38px;
                        background: root.warp_mode_doh_active ? Theme.accent-bg-trans : Theme.card-bg-opaque.transparentize(60%);
                        border-width: 1px;
                        border-color: root.warp_mode_doh_active ? Theme.accent : Theme.border;
                        border-radius: 10px;
                        
                        Text {
                            text: "DoH DNS Only";
                            font-size: 12px;
                            font-weight: 800;
                            color: root.warp_mode_doh_active ? Theme.accent : Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        
                        TouchArea {
                            clicked => {
                                root.warp_mode_doh_active = true;
                                root.warp_mode_clicked("doh");
                            }
                        }
                    }
 
                    // Tab 2: WARP+DoH Dual
                    Rectangle {
                        width: 140px;
                        height: 38px;
                        background: !root.warp_mode_doh_active ? Theme.warning-bg-trans : Theme.card-bg-opaque.transparentize(60%);
                        border-width: 1px;
                        border-color: !root.warp_mode_doh_active ? Theme.warning : Theme.border;
                        border-radius: 10px;
                        
                        Text {
                            text: "WARP+DoH Dual";
                            font-size: 12px;
                            font-weight: 800;
                            color: !root.warp_mode_doh_active ? Theme.warning : Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        
                        TouchArea {
                            clicked => {
                                root.warp_mode_doh_active = false;
                                root.warp_mode_clicked("warp+doh");
                            }
                        }
                    }
                }
            }
        }

        // Lower Section: Logs Console & RPM button
        VerticalLayout {
            spacing: 12px;
            alignment: end;
            
            // Action: Install daemon button
            Rectangle {
                height: 40px;
                background: Theme.card-bg-opaque;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 12px;
                
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Text { text: "📥"; font-size: 12px; vertical-alignment: center; }
                    Text {
                        text: "Install Daemon RPM via Polkit";
                        font-size: 14px;
                        font-weight: 800;
                        color: #cbd5e1;
                        vertical-alignment: center;
                    }
                }
                
                TouchArea {
                    clicked => { root.install_rpm_clicked(); }
                }
            }

            // Terminal Mini Log Output Dashboard
            VerticalLayout {
                spacing: 6px;
                Text {
                    text: "SYSTEM DIAGNOSTIC CONSOLE LOGS";
                    font-size: 12px;
                    font-weight: 800;
                    color: #475569;
                    letter-spacing: 1px;
                }
                Rectangle {
                    height: 160px;
                    background: Theme.interior-bg;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 12px;
                    
                    ScrollView {
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            alignment: start;
                            for entry in root.console_logs: Text {
                                text: entry;
                                font-size: 12px;
                                font-family: "JetBrains Mono";
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
