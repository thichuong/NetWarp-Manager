// Cloudflare WARP Controller & System Logs component
/*
 * ============================================================================
 * Developer Warning: Refer to architecture.md Section 6 for full Slint-Rust 
 * synchronization rules before modifying this file!
 * ============================================================================
 */

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

component WarpModeRow inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> is_active;
    callback clicked();

    height: 28px;
    border-radius: 6px;
    background: row_touch.has-hover ? Theme.accent-bg-trans : transparent;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        alignment: start;

        // Custom checkbox indicator matching Cloudflare UI
        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.is_active ? Theme.accent : Theme.card-bg-opaque;
            border-width: 1.5px;
            border-color: root.is_active ? Theme.accent : Theme.border;

            if (root.is_active) : Text {
                text: "✓";
                font-size: 11px;
                font-weight: 900;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Mode label text
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.is_active ? 800 : 600;
            color: root.is_active ? Theme.accent : (row_touch.has-hover ? Theme.text-heading : Theme.text-secondary);
            vertical-alignment: center;
        }
    }

    row_touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component WarpControlPanel inherits Rectangle {
    in-out property <string> warp_status_text;
    in-out property <string> warp_network_text;
    in-out property <string> warp_mode_badge;
    in-out property <bool> warp_toggle_state;
    in-out property <bool> warp_mode_doh_active;
    in-out property <[string]> console_logs;
    in-out property <string> warp_account_type: "Free";
    in-out property <string> current_warp_mode: "warp";

    pure function get_mode_label(mode: string) -> string {
        if (mode == "doh") { return "DNS only (HTTPS)"; }
        if (mode == "dot") { return "DNS only (TLS)"; }
        if (mode == "warp") { return "Traffic and DNS (UDP)"; }
        if (mode == "warp+doh") { return "Traffic and DNS (HTTPS)"; }
        if (mode == "warp+dot") { return "Traffic and DNS (TLS)"; }
        if (mode == "proxy") { return "Local proxy"; }
        if (mode == "tunnel_only") { return "Traffic only"; }
        return "Traffic and DNS (UDP)";
    }

    callback warp_toggle_clicked(bool);
    callback warp_mode_clicked(string);
    callback install_rpm_clicked();
    callback activate_license_clicked();

    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 24px;
    
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: space-between;
        
        // Upper Section: Shield emblem and connection toggle
        VerticalLayout {
            spacing: 10px;
            alignment: start;
            
            // Shield Graphics Center
            Rectangle {
                height: 110px;
                background: transparent;
                
                // Static status halo
                Rectangle {
                    width: 90px;
                    height: 90px;
                    border-radius: 45px;
                    background: transparent;
                    border-width: 1.5px;
                    border-color: root.warp_status_text == "Connected" ? Theme.success.transparentize(90%) : (root.warp_status_text == "Connecting..." ? Theme.warning.transparentize(90%) : Theme.danger.transparentize(90%));
                }

                // Glowing Shield Circle
                shield-container := Rectangle {
                    width: 70px;
                    height: 70px;
                    border-radius: 35px;
                    background: Theme.interior-bg;
                    border-width: 1px;
                    border-color: root.warp_status_text == "Connected" ? Theme.success : (root.warp_status_text == "Connecting..." ? Theme.warning : Theme.danger);
                    
                    Image {
                        source: @image-url("../../assets/shield.svg");
                        width: 32px;
                        height: 32px;
                        colorize: root.warp_status_text == "Connected" ? Theme.success : (root.warp_status_text == "Connecting..." ? Theme.warning : Theme.danger);
                        x: (shield-container.width - self.width) / 2;
                        y: (shield-container.height - self.height) / 2;
                    }

                    // Led dynamic dot inside shield corner
                    Rectangle {
                        x: 48px;
                        y: 4px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.warp_status_text == "Connected" ? Theme.success : (root.warp_status_text == "Connecting..." ? Theme.warning : Theme.danger);
                        border-width: 2px;
                        border-color: Theme.interior-bg;
                    }
                }
            }

            // Status Info Block
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Cloudflare WARP Tunnel";
                    font-size: 15px;
                    font-weight: 800;
                    color: Theme.text-heading;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.warp_status_text;
                    font-size: 13px;
                    font-weight: 900;
                    color: root.warp_status_text == "Connected" ? Theme.success : (root.warp_status_text == "Connecting..." ? Theme.warning : Theme.danger);
                    font-family: "JetBrains Mono";
                    horizontal-alignment: center;
                    letter-spacing: 1.5px;
                }
                Text {
                    text: root.warp_network_text;
                    font-size: 12px;
                    color: Theme.text-label;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    width: 280px;
                }
                
                // Account type badge
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Rectangle {
                        background: root.warp_account_type == "Unlimited" ? Theme.success.transparentize(85%) : Theme.card-bg.transparentize(15%);
                        border-width: 1px;
                        border-color: root.warp_account_type == "Unlimited" ? Theme.success : Theme.border;
                        border-radius: 12px;
                        height: 22px;
                        
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: "Account: " + root.warp_account_type;
                                font-size: 12px;
                                font-weight: 800;
                                color: root.warp_account_type == "Unlimited" ? Theme.success : Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
                      // iOS styled Toggle connected switch
            Rectangle {
                height: 40px;
                background: Theme.interior-bg.transparentize(30%);
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 12px;
                
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;
                    Text {
                        text: root.warp_toggle_state ? "CONNECT CLIENT ACTIVATED" : "CONNECT CLIENT DEACTIVATED";
                        font-size: 12px;
                        font-weight: 800;
                        color: root.warp_toggle_state ? Theme.success : Theme.text-muted;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                    }
 
                    // Interactive switch toggle pill
                    Rectangle {
                        width: 44px;
                        height: 24px;
                        border-radius: 12px;
                        background: root.warp_toggle_state ? (root.warp_mode_doh_active ? Theme.accent : Theme.warning) : Theme.base-bg;
                        y: 8px;
                        
                        // Inner toggle circular knob
                        Rectangle {
                            x: root.warp_toggle_state ? 22px : 2px;
                            y: 2px;
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: Theme.toggle-knob;
                            
                            animate x { duration: 200ms; easing: ease-in-out; }
                        }

                        TouchArea {
                            clicked => {
                                root.warp_toggle_state = !root.warp_toggle_state;
                                root.warp_toggle_clicked(root.warp_toggle_state);
                            }
                        }
                    }
                }
            }

            // WARP mode selection dropdown / menu
            VerticalLayout {
                spacing: 6px;
                padding-top: 2px;
                
                Text {
                    text: "OPERATION TUNNEL MODE";
                    font-size: 11px;
                    font-weight: 800;
                    color: Theme.text-section;
                    letter-spacing: 1.2px;
                    horizontal-alignment: center;
                }

                // Dropdown Trigger Selector Button
                selector_btn := Rectangle {
                    height: 36px;
                    background: selector_touch.has-hover ? Theme.card-bg-opaque : Theme.interior-bg;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 10px;
                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;
                        
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: "🌐";
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.get_mode_label(root.current_warp_mode);
                                font-size: 12px;
                                font-weight: 800;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "▼";
                            font-size: 10px;
                            font-weight: 800;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    selector_touch := TouchArea {
                        clicked => {
                            mode_popup.show();
                        }
                    }

                    // Floating Dropdown Popup attached to selector button (floats on top and overflows)
                    mode_popup := PopupWindow {
                        x: 0px;
                        y: selector_btn.height + 4px;
                        width: selector_btn.width;

                        Rectangle {
                            background: Theme.interior-bg;
                            border-width: 1px;
                            border-color: Theme.accent;
                            border-radius: 12px;
                            
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                
                                // Option 1: DNS only (HTTPS)
                                WarpModeRow {
                                    label: "DNS only (HTTPS)";
                                    is_active: root.current_warp_mode == "doh";
                                    clicked => {
                                        root.current_warp_mode = "doh";
                                        root.warp_mode_clicked("doh");
                                    }
                                }

                                // Option 2: DNS only (TLS)
                                WarpModeRow {
                                    label: "DNS only (TLS)";
                                    is_active: root.current_warp_mode == "dot";
                                    clicked => {
                                        root.current_warp_mode = "dot";
                                        root.warp_mode_clicked("dot");
                                    }
                                }

                                // Option 3: Traffic and DNS (UDP)
                                WarpModeRow {
                                    label: "Traffic and DNS (UDP)";
                                    is_active: root.current_warp_mode == "warp";
                                    clicked => {
                                        root.current_warp_mode = "warp";
                                        root.warp_mode_clicked("warp");
                                    }
                                }

                                // Option 4: Traffic and DNS (HTTPS)
                                WarpModeRow {
                                    label: "Traffic and DNS (HTTPS)";
                                    is_active: root.current_warp_mode == "warp+doh";
                                    clicked => {
                                        root.current_warp_mode = "warp+doh";
                                        root.warp_mode_clicked("warp+doh");
                                    }
                                }

                                // Option 5: Traffic and DNS (TLS)
                                WarpModeRow {
                                    label: "Traffic and DNS (TLS)";
                                    is_active: root.current_warp_mode == "warp+dot";
                                    clicked => {
                                        root.current_warp_mode = "warp+dot";
                                        root.warp_mode_clicked("warp+dot");
                                    }
                                }

                                // Option 6: Local proxy
                                WarpModeRow {
                                    label: "Local proxy";
                                    is_active: root.current_warp_mode == "proxy";
                                    clicked => {
                                        root.current_warp_mode = "proxy";
                                        root.warp_mode_clicked("proxy");
                                    }
                                }

                                // Option 7: Traffic only
                                WarpModeRow {
                                    label: "Traffic only";
                                    is_active: root.current_warp_mode == "tunnel_only";
                                    clicked => {
                                        root.current_warp_mode = "tunnel_only";
                                        root.warp_mode_clicked("tunnel_only");
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Lower Section: Logs Console & RPM button
        VerticalLayout {
            spacing: 8px;
            alignment: end;
            
            // Action buttons row (Install Daemon / Activate WARP+)
            HorizontalLayout {
                spacing: 8px;
                
                // Button 1: Install Daemon
                Rectangle {
                    horizontal-stretch: 1;
                    height: 32px;
                    background: Theme.card-bg-opaque;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 10px;
                    
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;
                        Text { text: "📥"; font-size: 11px; vertical-alignment: center; }
                        Text {
                            text: "Install Daemon";
                            font-size: 12px;
                            font-weight: 800;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                    
                    TouchArea {
                        clicked => { root.install_rpm_clicked(); }
                    }
                }
                
                // Button 2: Activate WARP+
                Rectangle {
                    horizontal-stretch: 1;
                    height: 32px;
                    background: Theme.card-bg-opaque;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 10px;
                    
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;
                        Text {
                            text: "Activate WARP+";
                            font-size: 12px;
                            font-weight: 800;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                    
                    TouchArea {
                        clicked => { root.activate_license_clicked(); }
                    }
                }
            }

            // Terminal Mini Log Output Dashboard
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "SYSTEM DIAGNOSTIC CONSOLE LOGS";
                    font-size: 11px;
                    font-weight: 800;
                    color: Theme.text-section;
                    letter-spacing: 1px;
                }
                Rectangle {
                    height: 120px;
                    background: Theme.interior-bg;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 10px;
                    
                    ScrollView {
                        // Auto-scroll to the bottom of the log list when content height changes
                        viewport-y: self.visible-height < self.viewport-height ? self.visible-height - self.viewport-height : 0px;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            alignment: start;
                            for entry in root.console_logs: Text {
                                text: entry;
                                font-size: 12px;
                                font-family: "JetBrains Mono";
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
