// Collapsible Active Wifi Connection details component
/*
 * ============================================================================
 * Developer Warning: Refer to architecture.md Section 6 for full Slint-Rust 
 * synchronization rules before modifying this file!
 * ============================================================================
 */

import { WifiNetwork } from "structs.slint";
import { Theme } from "theme.slint";

export component ActiveWifiPanel inherits Rectangle {
    in-out property <WifiNetwork> active_wifi;

    callback change_network_clicked();

    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 24px;
    height: 225px;
    
    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // Accordion Header block
        HorizontalLayout {
            alignment: space-between;
            
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    
                    // Dynamic Wi-Fi signal icon block
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            background: root.active_wifi.active ? Theme.accent-bg-trans : rgba(148, 163, 184, 0.05);
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: root.active_wifi.active ? Theme.accent-border-trans : rgba(148, 163, 184, 0.15);
                            
                            VerticalLayout {
                                alignment: center;
                                if (root.active_wifi.band == "Ethernet") : VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 18px;
                                            height: 14px;
                                            border-width: 2px;
                                            border-color: Theme.success;
                                            border-radius: 2px;
                                            Rectangle {
                                                width: 6px;
                                                height: 4px;
                                                x: 4px;
                                                y: -5px;
                                                background: Theme.success;
                                                border-radius: 1px;
                                            }
                                            HorizontalLayout {
                                                padding-left: 2px;
                                                padding-right: 2px;
                                                spacing: 1px;
                                                alignment: center;
                                                y: 5px;
                                                Rectangle { width: 1px; height: 4px; background: Theme.success; }
                                                Rectangle { width: 1px; height: 4px; background: Theme.success; }
                                                Rectangle { width: 1px; height: 4px; background: Theme.success; }
                                                Rectangle { width: 1px; height: 4px; background: Theme.success; }
                                            }
                                        }
                                    }
                                }
                                if (root.active_wifi.band != "Ethernet") : HorizontalLayout {
                                    height: 24px;
                                    spacing: 3px;
                                    alignment: center;
                                    
                                    // Bar 1
                                    VerticalLayout {
                                        alignment: end;
                                        Rectangle {
                                            width: 4px;
                                            height: 7px;
                                            border-radius: 1px;
                                            background: (root.active_wifi.active && root.active_wifi.signal >= 0) ? Theme.success : rgba(148, 163, 184, 0.3);
                                        }
                                    }
                                    // Bar 2
                                    VerticalLayout {
                                        alignment: end;
                                        Rectangle {
                                            width: 4px;
                                            height: 12px;
                                            border-radius: 1px;
                                            background: (root.active_wifi.active && root.active_wifi.signal >= 25) ? Theme.success : rgba(148, 163, 184, 0.3);
                                        }
                                    }
                                    // Bar 3
                                    VerticalLayout {
                                        alignment: end;
                                        Rectangle {
                                            width: 4px;
                                            height: 17px;
                                            border-radius: 1px;
                                            background: (root.active_wifi.active && root.active_wifi.signal >= 50) ? Theme.success : rgba(148, 163, 184, 0.3);
                                        }
                                    }
                                    // Bar 4
                                    VerticalLayout {
                                        alignment: end;
                                        Rectangle {
                                            width: 4px;
                                            height: 22px;
                                            border-radius: 1px;
                                            background: (root.active_wifi.active && root.active_wifi.signal >= 75) ? Theme.success : rgba(148, 163, 184, 0.3);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.active_wifi.band == "Ethernet" ? "Active Ethernet Connection" : "Active Wi-Fi Connection";
                            font-size: 12px;
                            font-weight: 800;
                            color: Theme.text-label;
                            letter-spacing: 1px;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text {
                                text: root.active_wifi.ssid;
                                font-size: 17px;
                                font-weight: 900;
                                color: Theme.text-heading;
                            }
                            // Signal Strength Badge
                            if (root.active_wifi.active && root.active_wifi.band != "Ethernet") : Rectangle {
                                background: Theme.success-bg-trans;
                                border-width: 1px;
                                border-color: Theme.success-border-trans;
                                border-radius: 8px;
                                height: 22px;
                                y: 2px;
                                
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: Theme.success;
                                        }
                                    }
                                    Text {
                                        text: "Signal: " + root.active_wifi.signal + "%";
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: Theme.success;
                                        font-family: "JetBrains Mono";
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            // Frequency / Channel Badge
                            if (root.active_wifi.active && root.active_wifi.band != "Ethernet") : Rectangle {
                                background: Theme.warning-bg-trans;
                                border-width: 1px;
                                border-color: rgba(243, 156, 18, 0.25);
                                border-radius: 8px;
                                height: 22px;
                                y: 2px;
                                
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: Theme.warning;
                                        }
                                    }
                                    Text {
                                        text: "Channel: " + root.active_wifi.channel + " (" + root.active_wifi.frequency + ")";
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: Theme.warning;
                                        font-family: "JetBrains Mono";
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            // Realtime rate link badge
                            if (root.active_wifi.active) : Rectangle {
                                background: Theme.accent-bg-trans;
                                border-width: 1px;
                                border-color: Theme.accent-border-trans;
                                border-radius: 8px;
                                height: 22px;
                                y: 2px;
                                
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: Theme.accent;
                                        }
                                    }
                                    Text {
                                        text: "Link Speed: " + root.active_wifi.rate;
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: Theme.accent;
                                        font-family: "JetBrains Mono";
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Interactive controls
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;
                    
                    // Change network action button
                    if (root.active_wifi.band != "Ethernet") : Rectangle {
                        background: Theme.card-bg.transparentize(15%);
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 32px;
                        
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;
                            Text {
                                text: "Change Network ➔";
                                font-size: 12px;
                                font-weight: 900;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                        }
                        
                        TouchArea {
                            clicked => { root.change_network_clicked(); }
                        }
                    }
                }
            }
        }

        // Collapsible Detailed Accordion Panel
        HorizontalLayout {
            spacing: 16px;
            padding-top: 8px;
            
            // Left Side parameters (Wi-Fi hardware details)
            VerticalLayout {
                spacing: 8px;
                
                Text {
                    text: root.active_wifi.band == "Ethernet" ? "🟢 Ethernet Hardware parameters" : "🟢 Wi-Fi Hardware parameters";
                    font-size: 12px;
                    font-weight: 900;
                    color: Theme.success;
                    letter-spacing: 0.5px;
                }

                if (root.active_wifi.band != "Ethernet") : HorizontalLayout {
                    Text { text: "Security Type:"; color: Theme.text-label; font-size: 12px; }
                    Text { text: root.active_wifi.security; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: right; font-family: "JetBrains Mono"; }
                }
                if (root.active_wifi.band != "Ethernet") : Rectangle { height: 1px; background: Theme.border-trans; }
                if (root.active_wifi.band != "Ethernet") : HorizontalLayout {
                    Text { text: "BSSID (Access Point MAC):"; color: Theme.text-label; font-size: 12px; }
                    Text { text: root.active_wifi.bssid; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: right; font-family: "JetBrains Mono"; }
                }
                if (root.active_wifi.band != "Ethernet") : Rectangle { height: 1px; background: Theme.border-trans; }
                HorizontalLayout {
                    Text { text: root.active_wifi.band == "Ethernet" ? "Ethernet device Interface:" : "Wireless device Interface:"; color: Theme.text-label; font-size: 12px; }
                    Text { text: root.active_wifi.device; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: right; font-family: "JetBrains Mono"; }
                }
                Rectangle { height: 1px; background: Theme.border-trans; }
                HorizontalLayout {
                    Text { text: "Hardware MAC Address:"; color: Theme.text-label; font-size: 12px; }
                    Text { text: root.active_wifi.mac; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: right; font-family: "JetBrains Mono"; }
                }
            }

            // Middle divider line
            Rectangle {
                width: 1px;
                background: Theme.divider;
            }

            // Right Side parameters (IPv4/DNS configurations)
            VerticalLayout {
                spacing: 8px;
                
                Text {
                    text: "🔵 IPv4 Protocol configurations";
                    font-size: 12px;
                    font-weight: 900;
                    color: Theme.accent;
                    letter-spacing: 0.5px;
                }

                HorizontalLayout {
                    Text { text: "IP Address assigned:"; color: Theme.text-label; font-size: 12px; }
                    Text { text: root.active_wifi.ip_address; color: Theme.text-primary; font-size: 12px; font-weight: 800; horizontal-alignment: right; font-family: "JetBrains Mono"; }
                }
                Rectangle { height: 1px; background: Theme.border-trans; }
                HorizontalLayout {
                    Text { text: "Default Gateway router:"; color: Theme.text-label; font-size: 12px; }
                    Text { text: root.active_wifi.gateway; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: right; font-family: "JetBrains Mono"; }
                }
                Rectangle { height: 1px; background: Theme.border-trans; }
                HorizontalLayout {
                    Text { text: "Primary Nameserver DNS:"; color: Theme.text-label; font-size: 12px; }
                    Text { text: root.active_wifi.dns_primary; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: right; font-family: "JetBrains Mono"; }
                }
            }
        }
    }
}
