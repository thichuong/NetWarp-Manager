// Overlay Dialogs and Modals Components
/*
 * ============================================================================
 * Developer Warning: Refer to architecture.md Section 6 for full Slint-Rust 
 * synchronization rules before modifying this file!
 * ============================================================================
 */

import { ScrollView, LineEdit } from "std-widgets.slint";
import { WifiNetwork } from "structs.slint";
import { Theme } from "theme.slint";

export component WifiScanModal inherits Rectangle {
    in-out property <bool> is_scanning;
    in-out property <[WifiNetwork]> wifi_list;

    callback close_modals();
    callback wifi_selected(string, string);
    callback scan_range_clicked();

    background: Theme.interior-bg.transparentize(15%); // overlay dark backdrop blur
    
    TouchArea {} // Consume all pointer events to prevent clicking components underneath the modal

    Rectangle {
        width: 480px;
        height: 520px;
        background: Theme.card-bg-opaque.transparentize(5%);
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 28px;
        
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            
            // Modal Header
            HorizontalLayout {
                alignment: space-between;
                
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        background: Theme.accent-bg-trans;
                        border-radius: 10px;
                        Text { text: "📶"; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Available Wi-Fi Networks"; font-size: 14px; font-weight: 800; color: Theme.text-heading; }
                        Text { text: "Select a wireless network below"; font-size: 12px; color: Theme.text-label; }
                    }
                }

                // Close x button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: Theme.card-bg-opaque.transparentize(40%);
                    border-radius: 6px;
                    Text { text: "✖"; font-size: 12px; color: Theme.text-subtle; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        clicked => { root.close_modals(); }
                    }
                }
            }

            // Dynamic radar scan pulse banner when isScanning is true
            if (root.is_scanning) : Rectangle {
                height: 50px;
                background: Theme.accent.transparentize(95%);
                border-width: 1px;
                border-color: Theme.accent-bg-trans;
                border-radius: 12px;
                
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text { text: "🔄"; font-size: 14px; vertical-alignment: center; }
                    Text {
                        text: "SCANNING FREQUENCIES IN RANGE...";
                        font-size: 12px;
                        font-weight: 900;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                }
            }

            // Scrollable Wifi Network cards list
            Rectangle {
                background: Theme.interior-bg;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 16px;
                vertical-stretch: 1; // expand to fill height
                
                ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 8px;
                        alignment: start;
                        
                        if (root.wifi_list.length == 0 && !root.is_scanning) : Text {
                            text: "No Wi-Fi systems discovered. Trigger a rescan.";
                            font-size: 12px;
                            color: Theme.text-label;
                            horizontal-alignment: center;
                        }
                        
                        for net in root.wifi_list: Rectangle {
                            height: 56px;
                            background: net.active ? Theme.accent.transparentize(92%) : Theme.card-bg-opaque.transparentize(70%);
                            border-width: 1px;
                            border-color: net.active ? Theme.accent : Theme.border;
                            border-radius: 10px;
                            
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Text { text: net.active ? "🟢" : "⚪"; font-size: 12px; vertical-alignment: center; }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: net.ssid;
                                            font-size: 12.5px;
                                            font-weight: 800;
                                            color: net.active ? Theme.accent : Theme.text-primary;
                                        }
                                        Text {
                                            text: net.bssid;
                                            font-size: 12px;
                                            font-family: "JetBrains Mono";
                                            color: net.active ? Theme.accent.transparentize(40%) : Theme.text-muted;
                                        }
                                    }
                                }
                                
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: end;
                                    
                                    // Signal badge
                                    Text {
                                        text: net.signal + "% signal";
                                        font-size: 12px;
                                        color: Theme.text-label;
                                        font-family: "JetBrains Mono";
                                        vertical-alignment: center;
                                    }
                                    
                                    // Band badge (e.g. 5GHz)
                                    Rectangle {
                                        background: Theme.base-bg;
                                        border-radius: 4px;
                                        height: 18px;
                                        y: 19px;
                                        
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            Text {
                                                text: net.band;
                                                font-size: 12px;
                                                font-weight: 800;
                                                color: Theme.text-secondary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                            
                            TouchArea {
                                clicked => {
                                    root.wifi_selected(net.ssid, net.bssid);
                                }
                            }
                        }
                    }
                }
            }

            // Modal Footer
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Found: " + root.wifi_list.length + " networks";
                    font-size: 12px;
                    color: Theme.text-label;
                    vertical-alignment: center;
                }
                
                // Scan button
                Rectangle {
                    background: Theme.accent;
                    border-radius: 8px;
                    height: 32px;
                    
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: "Rescan Range";
                            font-size: 12px;
                            font-weight: 900;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                    
                    TouchArea {
                        clicked => { root.scan_range_clicked(); }
                    }
                }
            }
        }
    }
}

export component PasswordModal inherits Rectangle {
    in-out property <string> selected_wifi_ssid;
    in-out property <string> selected_wifi_bssid;
    in-out property <string> pwd_input_val;
    in-out property <bool> lock_bssid;

    callback close_modals();
    callback connect_wifi_clicked(string, string, string, bool); // bssid, ssid, password, lock_bssid

    background: Theme.interior-bg.transparentize(15%); // dark overlay
    
    TouchArea {} // Consume all pointer events to prevent clicking components underneath the modal

    Rectangle {
        width: 400px;
        height: 280px;
        background: Theme.card-bg-opaque.transparentize(5%);
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 24px;
        
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: space-between;
            
            // Header
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "🔒 Wi-Fi Credentials Required";
                    font-size: 14px;
                    font-weight: 800;
                    color: Theme.text-heading;
                }
                Text {
                    text: "Connect to: " + root.selected_wifi_ssid;
                    font-size: 12px;
                    color: Theme.text-subtle;
                }
            }

            // Password input
            VerticalLayout {
                spacing: 6px;
                Text { text: "WPA/WPA2 PASSWORD KEY"; font-size: 12px; font-weight: 800; color: Theme.text-label; }
                
                // Slint LineEdit input box
                LineEdit {
                    placeholder-text: "Provide wireless password...";
                    text: root.pwd_input_val;
                    edited(val) => { root.pwd_input_val = val; }
                }
            }

            // Lock BSSID checkbox general option
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                
                // Simple checkbox drawing
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    background: root.lock_bssid ? Theme.accent : transparent;
                    y: 1px;
                    
                    if (root.lock_bssid) : Text {
                        text: "✓";
                        font-size: 12px;
                        font-weight: 900;
                        color: Theme.toggle-knob;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    
                    TouchArea {
                        clicked => { root.lock_bssid = !root.lock_bssid; }
                    }
                }
                
                Text {
                    text: "Lock BSSID (Fix connection profile to this exact MAC)";
                    font-size: 12px;
                    color: Theme.text-subtle;
                    vertical-alignment: center;
                }
            }

            // Action controls buttons
            HorizontalLayout {
                spacing: 12px;
                alignment: end;
                
                // Cancel action
                Rectangle {
                    background: Theme.card-bg-opaque.transparentize(40%);
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    width: 80px;
                    height: 32px;
                    
                    Text {
                        text: "Cancel";
                        font-size: 12px;
                        font-weight: 800;
                        color: Theme.text-subtle;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    
                    TouchArea {
                        clicked => { root.close_modals(); }
                    }
                }

                // Connect action
                 Rectangle {
                    background: Theme.accent;
                    border-radius: 8px;
                    width: 100px;
                    height: 32px;
                    
                    Text {
                        text: "Connect Key";
                        font-size: 12px;
                        font-weight: 900;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    
                    TouchArea {
                        clicked => {
                            root.connect_wifi_clicked(
                                root.selected_wifi_bssid,
                                root.selected_wifi_ssid,
                                root.pwd_input_val,
                                root.lock_bssid
                            );
                        }
                    }
                }
            }
        }
    }
}

export component LicenseModal inherits Rectangle {
    in-out property <string> license_input_val;

    callback close_modals();
    callback submit_license_clicked(string);

    background: Theme.interior-bg.transparentize(15%); // overlay dark backdrop blur
    
    TouchArea {} // Consume all pointer events to prevent clicking components underneath

    Rectangle {
        width: 400px;
        height: 240px;
        background: Theme.card-bg-opaque.transparentize(5%);
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 24px;
        
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: space-between;
            
            // Header Info
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Activate WARP+ Unlimited";
                    font-size: 14px;
                    font-weight: 800;
                    color: Theme.text-heading;
                }
                Text {
                    text: "Enter your 26-character license key below";
                    font-size: 12px;
                    color: Theme.text-subtle;
                }
            }

            // License key input field
            VerticalLayout {
                spacing: 6px;
                Text { text: "LICENSE KEY (AAAAA-BBBBB-CCCCC-...)"; font-size: 12px; font-weight: 800; color: Theme.text-label; }
                
                LineEdit {
                    placeholder-text: "e.g. KT26P85W-FRS62C04-6r2S5TG7";
                    text: root.license_input_val;
                    edited(val) => { root.license_input_val = val; }
                }
            }

            // Action controls buttons
            HorizontalLayout {
                spacing: 12px;
                alignment: end;
                
                // Cancel button
                Rectangle {
                    background: Theme.card-bg-opaque.transparentize(40%);
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    width: 80px;
                    height: 32px;
                    
                    Text {
                        text: "Cancel";
                        font-size: 12px;
                        font-weight: 800;
                        color: Theme.text-subtle;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    
                    TouchArea {
                        clicked => { root.close_modals(); }
                    }
                }

                // Activate button
                Rectangle {
                    background: Theme.accent;
                    border-radius: 8px;
                    width: 100px;
                    height: 32px;
                    
                    Text {
                        text: "Activate";
                        font-size: 12px;
                        font-weight: 900;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    
                    TouchArea {
                        clicked => {
                            root.submit_license_clicked(root.license_input_val);
                        }
                    }
                }
            }
        }
    }
}

