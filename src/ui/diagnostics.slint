// Diagnostics and Geolocation Component
/*
 * ============================================================================
 * Developer Warning: Refer to architecture.md Section 6 for full Slint-Rust 
 * synchronization rules before modifying this file!
 * ============================================================================
 */

import { PingResult, IPGeolocatorInfo } from "structs.slint";
import { Theme } from "theme.slint";

export component DiagnosticsPanel inherits HorizontalLayout {
    in-out property <PingResult> ping1;
    in-out property <PingResult> ping2;
    in-out property <IPGeolocatorInfo> geo_info;

    spacing: 16px;
    
    // Left widget: Ping latencies (Google & Cloudflare)
    VerticalLayout {
        width: 320px;
        spacing: 8px;
        
        Text {
            text: "⚡ PING LATENCY DIAGNOSTICS";
            font-size: 12px;
            font-weight: 800;
            color: Theme.text-label;
            letter-spacing: 1px;
        }

        // Ping Cloudflare Block
        Rectangle {
            height: 60px;
            background: Theme.card-bg;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 14px;
            
            VerticalLayout {
                padding: 12px;
                alignment: center;
                spacing: 4px;
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: Theme.success; y: 4px; }
                        Text { text: "Cloudflare (1.1.1.1)"; font-size: 12px; font-weight: 700; color: Theme.text-secondary; font-family: "JetBrains Mono"; }
                    }
                    Text {
                        text: root.ping1.status == "Online" ? Math.round(root.ping1.latency) + " ms" : "Offline";
                        font-size: 13px;
                        font-weight: 900;
                        color: root.ping1.status == "Online" ? Theme.success : Theme.danger;
                        font-family: "JetBrains Mono";
                    }
                }
                
                // Miniature bar gauge
                Rectangle {
                    height: 3px;
                    background: Theme.interior-bg;
                    border-radius: 1.5px;
                    
                    Rectangle {
                        x: 0px;
                        width: Math.min(1.0, root.ping1.latency / 200.0) * parent.width;
                        height: 100%;
                        border-radius: 1.5px;
                        background: root.ping1.status == "Online" ? Theme.success : Theme.danger;
                    }
                }
            }
        }

        // Ping Google Block
        Rectangle {
            height: 60px;
            background: Theme.card-bg;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 14px;
            
            VerticalLayout {
                padding: 12px;
                alignment: center;
                spacing: 4px;
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: Theme.accent; y: 4px; }
                        Text { text: "Google (8.8.8.8)"; font-size: 12px; font-weight: 700; color: Theme.text-secondary; font-family: "JetBrains Mono"; }
                    }
                    Text {
                        text: root.ping2.status == "Online" ? Math.round(root.ping2.latency) + " ms" : "Offline";
                        font-size: 13px;
                        font-weight: 900;
                        color: root.ping2.status == "Online" ? Theme.accent : Theme.danger;
                        font-family: "JetBrains Mono";
                    }
                }
                
                // Miniature bar gauge
                Rectangle {
                    height: 3px;
                    background: Theme.interior-bg;
                    border-radius: 1.5px;
                    
                    Rectangle {
                        x: 0px;
                        width: Math.min(1.0, root.ping2.latency / 200.0) * parent.width;
                        height: 100%;
                        border-radius: 1.5px;
                        background: root.ping2.status == "Online" ? Theme.accent : Theme.danger;
                    }
                }
            }
        }
    }

    // Right widget: IP Geolocation details (Public coordinates & ISP)
    VerticalLayout {
        spacing: 8px;
        
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "🌍 PUBLIC IP GEOLOCATION";
                font-size: 12px;
                font-weight: 800;
                color: Theme.text-label;
                letter-spacing: 1px;
            }
            
            // Direct / Protected WARP Badge
            Rectangle {
                background: root.geo_info.warp_badge == "WARP" ? Theme.success-bg-trans : Theme.danger-bg-trans;
                border-width: 1px;
                border-color: root.geo_info.warp_badge == "WARP" ? Theme.success-border-trans : Theme.danger-border-trans;
                border-radius: 6px;
                height: 18px;
                
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: root.geo_info.warp_badge;
                        font-size: 12px;
                        font-weight: 900;
                        color: root.geo_info.warp_badge == "WARP" ? Theme.success : Theme.danger;
                        font-family: "JetBrains Mono";
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Geo info grid card
        Rectangle {
            background: Theme.card-bg;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 12px;
            height: 120px;
            
            GridLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                
                // Row 1
                Row {
                    VerticalLayout {
                        Text { text: "IP Address"; color: Theme.text-label; font-size: 12px; font-weight: 800; letter-spacing: 0.5px; }
                        Text { text: root.geo_info.ip; color: Theme.text-primary; font-size: 13px; font-weight: 700; font-family: "JetBrains Mono"; }
                    }
                    VerticalLayout {
                        Text { text: "Location"; color: Theme.text-label; font-size: 12px; font-weight: 800; letter-spacing: 0.5px; }
                        Text { text: root.geo_info.location; color: Theme.text-primary; font-size: 13px; font-weight: 700; }
                    }
                }
                
                // Row 2
                Row {
                    VerticalLayout {
                        Text { text: "ISP Provider"; color: Theme.text-label; font-size: 12px; font-weight: 800; letter-spacing: 0.5px; }
                        Text { text: root.geo_info.isp; color: Theme.text-secondary; font-size: 13px; font-weight: 700; }
                    }
                    VerticalLayout {
                        Text { text: "Coordinates"; color: Theme.text-label; font-size: 12px; font-weight: 800; letter-spacing: 0.5px; }
                        Text { text: root.geo_info.coordinates; color: Theme.text-secondary; font-size: 13px; font-weight: 700; font-family: "JetBrains Mono"; }
                    }
                }
            }
        }
    }
}
