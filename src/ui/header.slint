// Header Panel component for WiWarp

import { Theme } from "theme.slint";

export component HeaderPanel inherits Rectangle {
    height: 70px;
    background: Theme.card-bg;
    border-radius: 20px;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 16px;
            alignment: start;
            
            // Logo Emblem (WiWarp Shield)
            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../assets/logo.svg");
                    width: 42px;
                    height: 42px;
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: "WIWARP";
                    font-size: 20px;
                    font-weight: 900;
                    color: #f8fafc;
                    letter-spacing: 0.1px;
                }
                Text {
                    text: "HIGH-FIDELITY NETWORK TERMINAL MANAGER";
                    font-size: 12px;
                    font-weight: 800;
                    color: #64748b;
                    letter-spacing: 1.5px;
                }
            }
        }

        // Header status info bar
        HorizontalLayout {
            spacing: 16px;
            alignment: end;
            
            // Quick stats
            VerticalLayout {
                alignment: center;
                Text {
                    text: "OS PLATFORM";
                    font-size: 12px;
                    font-weight: 800;
                    color: #64748b;
                    letter-spacing: 1px;
                    horizontal-alignment: right;
                }
                Text {
                    text: "FEDORA LINUX";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    horizontal-alignment: right;
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 1px;
                    height: 30px;
                    background: #1e293b;
                }
            }

            // System Engine Dot
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.success;
                    }
                    Text {
                        text: "ENGINE OK";
                        font-size: 12px;
                        font-weight: 900;
                        color: Theme.success;
                        vertical-alignment: center;
                    }
                }
            }


        }
    }
}
